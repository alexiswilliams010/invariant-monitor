{
  "name": "invariant-monitor",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "bin": {
    "invariant-monitor": "dist/cli.js"
  },
  "scripts": {
    "dev": "tsx src/cli.ts",
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test test/*.test.ts",
    "format": "prettier --write src test package.json tsconfig*.json README.md",
    "format:check": "prettier --check src test package.json tsconfig*.json README.md",
    "check": "npm run typecheck && npm run test && npm run format:check && npm run build"
  },
  "devDependencies": {
    "@types/node": "^24.19.2",
    "prettier": "^3.9.10",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  },
  "dependencies": {
    "@d2lang/d2": "^0.1.34",
    "@resvg/resvg-js": "^2.6.2",
    "sharp": "^0.35.5",
    "viem": "^2.57.4",
    "yaml": "^2.9.1"
  }
}
